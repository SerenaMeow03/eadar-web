# .env.example
# 复制本文件为 .env 并填入真实值（.env 已在 .gitignore 中，绝不提交）
# 填好后到 Netlify 后台也配置一遍（Site settings → Environment variables）

# Supabase 项目 URL（必填）
SUPABASE_URL=https://zyawwjxjdloubvcnyvtp.supabase.co

# Supabase service_role key（后端用，绝不暴露前端）
# 在 Supabase Dashboard → Settings → API → service_role 复制
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase anon key（前端登录用）
# 同上位置，anon public 那一行
SUPABASE_ANON_KEY=your-anon-key-here
